{
  "name": "pintopets",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@pintopets/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @pintopets/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @pintopets/db db:generate",
    "db:migrate": "pnpm --filter @pintopets/db db:migrate",
    "db:seed": "pnpm --filter @pintopets/db db:seed",
    "db:check": "pnpm --filter @pintopets/db db:check",
    "db:studio": "pnpm --filter @pintopets/db db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.11.10",
    "typescript": "6.0.3"
  }
}
