{
  "name": "pintopets",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@pintopets/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @pintopets/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "opsapi:up": "docker compose -f docker-compose.opsapi.yml up -d --wait opsapi && docker compose -f docker-compose.opsapi.yml up bootstrap",
    "opsapi:down": "docker compose -f docker-compose.opsapi.yml down",
    "opsapi:key": "docker compose -f docker-compose.opsapi.yml logs --no-log-prefix bootstrap | grep '^OPSAPI_'",
    "opsapi:types": "node scripts/opsapi-types.mjs && prettier --write apps/web/src/server/opsapi/pintopets.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.11.10",
    "typescript": "6.0.3"
  }
}
