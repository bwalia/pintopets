# PintoPets environment variables.
# Copy to .env.local (git-ignored) and fill in. Never commit real secrets.
# Variables marked [M1] are used now; the rest arrive in later milestones.

# ── App ──────────────────────────────────────────────────────────────────────
# [M1] Public base URL, used for absolute links, OpenAPI servers and emails.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set by the Helm chart in deployed rings (never at build time: one image is
# promoted int → test → acc → prod). Locally they default to "local" / "dev".
# APP_ENV=int
# APP_VERSION=abc1234

# [M3] Demo sign-in: everyone shares one demo account. Only for local and int
# until real sign-in (M2); the app refuses to start with it on prod.
DEMO_AUTH=true
# [M3] Uploaded photos directory (a persistent volume in k3s).
MEDIA_DIR=.data/media

# ── OpsAPI: PintoPets' data API and sign-in ──────────────────────────────────
# Local: `pnpm opsapi:up` (Docker), then copy the key from `pnpm opsapi:key`.
# k3s1 int: the in-cluster workstation-opsapi service; key from WSL Vault.
OPSAPI_URL=http://localhost:4042
# As the browser sees it (hosted sign-in). Defaults to OPSAPI_URL.
OPSAPI_PUBLIC_URL=
OPSAPI_NAMESPACE=pintopets
OPSAPI_API_KEY=opsk_replace_me
# Signs the session cookie after sign-in. 32+ random characters.
SESSION_SECRET=
# Encrypts authenticator (TOTP) secrets stored in OpsAPI: 32 random bytes, base64
# (openssl rand -base64 32). Never change it once users have enrolled.
TOTP_ENCRYPTION_KEY=

# ── Sentry (errors) ──────────────────────────────────────────────────────────
# [M1] Optional. Leave blank to disable Sentry locally.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only, for uploading source maps (CI / Vercel).
SENTRY_AUTH_TOKEN=

# ── Auth (Better Auth) ─── [M2] ──────────────────────────────────────────────
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte base64 key for encrypting TOTP secrets at rest (AES-256-GCM).
TOTP_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY_ID=v1

# ── Email (Resend) ─── [M2] ──────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="PintoPets <hello@pintopets.app>"

# ── Storage (Cloudflare R2, S3 API) ─── [M3] ─────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=pintopets-private

# ── Video (Mux) ─── [M3] ─────────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# ── Background jobs (Inngest) ─── [M4] ───────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Certificates ─── [M5] ────────────────────────────────────────────────────
# Ed25519 private key (PKCS#8 PEM, base64-encoded) and its key id.
CERT_SIGNING_PRIVATE_KEY=
CERT_SIGNING_KEY_ID=v1

# ── AI ─── [M6/M7] ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=
VOYAGE_API_KEY=
AI_EMBEDDING_MODEL=

# ── Payments (Stripe) ─── [M10] ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Analytics (PostHog) ─── [M11] ────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
